{
  "name": "ezcounter-registry",
  "version": "0.1.0",
  "private": false,
  "homepage": "https://github.com/ezpaarse-project/ezcounter#readme",
  "bugs": {
    "url": "https://github.com/ezpaarse-project/ezcounter/issues"
  },
  "license": "CeCILL",
  "author": "oxypomme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ezpaarse-project/ezcounter.git"
  },
  "type": "module",
  "main": "dist/app.mjs",
  "scripts": {
    "dev": "tsx watch --inspect=0.0.0.0 src/app.ts --dev",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "check": "tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "build:client": "vite build",
    "build:server": "tsdown",
    "start": "node --enable-source-maps dist/app.mjs"
  },
  "dependencies": {
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/vite": "^10.0.0",
    "@fastify/vue": "^2.0.1",
    "@unhead/vue": "^3.4.3",
    "pino": "catalog:",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@ezcounter/config": "workspace:*",
    "@ezcounter/database": "workspace:*",
    "@ezcounter/dto": "workspace:*",
    "@ezcounter/rolldown": "workspace:*",
    "@ezcounter/toolbox": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/swagger": "^9.8.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "catalog:test",
    "cron": "^4.4.0",
    "date-fns": "catalog:",
    "es-toolkit": "^1.53.0",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "http-status-codes": "catalog:",
    "json5": "catalog:build",
    "msw": "catalog:test",
    "ofetch": "catalog:",
    "ohash": "^2.0.12",
    "pino-pretty": "catalog:dev",
    "stream-chain": "catalog:",
    "stream-json": "catalog:",
    "tsdown": "catalog:build",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "^8.3.5",
    "vitest": "catalog:test",
    "vitest-mock-extended": "catalog:test"
  },
  "engines": {
    "node": "^24 || ^26"
  }
