{
  "name": "ezcounter-enricher",
  "version": "0.1.0",
  "private": false,
  "homepage": "https://github.com/ezpaarse-project/ezcounter#readme",
  "bugs": {
    "url": "https://github.com/ezpaarse-project/ezcounter/issues"
  },
  "license": "CeCILL",
  "author": "oxypomme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ezpaarse-project/ezcounter.git"
  },
  "type": "module",
  "main": "dist/app.mjs",
  "scripts": {
    "dev": "tsx watch --inspect=0.0.0.0 src/app.ts",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "check": "tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "build": "tsdown",
    "start": "node --enable-source-maps dist/app.mjs"
  },
  "dependencies": {
    "pino": "catalog:"
  },
  "devDependencies": {
    "@elastic/elasticsearch": "^7",
    "@ezcounter/config": "workspace:*",
    "@ezcounter/counter": "workspace:*",
    "@ezcounter/dto": "workspace:*",
    "@ezcounter/heartbeats": "workspace:*",
    "@ezcounter/rabbitmq": "workspace:*",
    "@ezcounter/rolldown": "workspace:*",
    "@ezcounter/simple-http": "workspace:*",
    "@ezcounter/toolbox": "workspace:*",
    "@keyv/redis": "^5.1.6",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:test",
    "cacheable": "^2.3.5",
    "date-fns": "catalog:",
    "http-status-codes": "catalog:",
    "isbn3": "2.0.7",
    "json5": "catalog:build",
    "keyv": "^5.6.0",
    "lru-cache": "^11.5.0",
    "msw": "catalog:test",
    "ofetch": "catalog:",
    "pino-pretty": "catalog:dev",
    "tsdown": "catalog:build",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:test",
    "vitest-mock-extended": "catalog:test"
  },
  "engines": {
    "node": "^24"
  }
}
