/// Data Host from source
model DataHost {
  /// ID of the host
  id String @id @default(cuid(2))

  /// Name of the host
  name  String
  /// Is the host local to this registry
  local Boolean @default(false)

  /// Additional params of the host
  params Json @default("{}")

  /// When the data host was created (or seen for the first time)
  createdAt DateTime  @default(now())
  /// When the data host was updated for the last time
  updatedAt DateTime? @updatedAt

  /// COUNTER releases supported by data host
  availableReleases DataHostRelease[]
  /// Local changes to apply
  changes           DataHostChange[]
  /// The jobs that harvested data host
  harvestJobs       HarvestJob[]

  // Actions done by sync
  actions RegistrySyncHostAction[]
}

/// Modification to apply to source data host
model DataHostChange {
  /// ID of the modification
  id         String @id @default(cuid(2))
  /// ID of the data host
  dataHostId String

  /// Modifications to apply to host
  diff Json[]

  /// When the info was created
  createdAt DateTime @default(now())

  /// Data Host
  target DataHost @relation(fields: [dataHostId], references: [id], onDelete: Cascade)
}
