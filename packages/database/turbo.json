{
  "$schema": "https://v2-9-15.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "db:generate": {
      "cache": false,
      "env": ["POSTGRES_URL", "POSTGRES_USERNAME", "POSTGRES_PASSWORD"]
    },
    "db:diff": {
      "cache": false,
      "env": ["POSTGRES_URL", "POSTGRES_USERNAME", "POSTGRES_PASSWORD"]
    },
    "db:migrate": {
      "cache": false,
      "interactive": true,
      "env": ["POSTGRES_URL", "POSTGRES_USERNAME", "POSTGRES_PASSWORD"]
    },
    "db:reset": {
      "cache": false,
      "interactive": true,
      "env": ["POSTGRES_URL", "POSTGRES_USERNAME", "POSTGRES_PASSWORD"]
    },
    "db:push": {
      "cache": false,
      "env": ["POSTGRES_URL", "POSTGRES_USERNAME", "POSTGRES_PASSWORD"]
    },
    "db:gui": {
      "cache": false,
      "env": ["POSTGRES_URL", "POSTGRES_USERNAME", "POSTGRES_PASSWORD"]
    },
    "check": {
      "dependsOn": ["db:generate"]
    }
  }
}
