{
  "compilerOptions": {
    // Required by PNPM
    "preserveSymlinks": false,
    // Used by ESBuild
    "target": "ESNext",
    "strict": true,

    // Used by TypeScript
    "lib": ["ESNext"],
    "moduleDetection": "force",
    "module": "Preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noImplicitOverride": true
  }
}
